#!/bin/bash

scope_main_ingress() {
  local scope_id="$1" ingresses count main
  ingresses=$(jq -c '.items // []')
  count=$(jq 'length' <<<"$ingresses")
  if [[ "$count" == "0" ]]; then
    return 0
  fi
  main=$(jq -c --arg scope "$scope_id" 'map(select(.metadata.name | test("-\($scope)-(internet-facing|internal)$")))[0] // empty' <<<"$ingresses")
  if [[ -z "$main" ]]; then
    main=$(jq -c '.[0]' <<<"$ingresses")
    [[ "$count" == "1" ]] || echo "⚠ No ingress of scope $scope_id is named k-8-s-<scope>-$scope_id-<visibility>; using $(jq -r '.metadata.name' <<<"$main")" >&2
  fi
  echo "$main"
}
