#!/bin/bash

if ! source "$(dirname "${BASH_SOURCE[0]}")/ingress_service_refs"; then
    echo "✗ Could not load ingress_service_refs"
    return 1
fi

ALB_NAME=$(echo "$CONTEXT" | jq -r .alb_name)
EXPOSER_DOMAIN=$(echo "$CONTEXT" | jq -r '.parameters.domain // .service.attributes.domain')

SERVICE_ID=$(echo "$CONTEXT" | jq -r .service.id)
SERVICE_SLUG=$(echo "$CONTEXT" | jq -r .service.slug)

INGRESS_NAME="k-8-s-$SERVICE_SLUG-$SERVICE_ID-public"
MAX_WAIT_SECONDS="${MAX_WAIT_SECONDS:-120}"
CHECK_INTERVAL="${CHECK_INTERVAL:-10}"
RECONCILIATION_EXPECTATION="${RECONCILIATION_EXPECTATION-present}"
VERIFY_SCOPE="${VERIFY_SCOPE-link}"
REMOVED_PATHS="${REMOVED_PATHS:-[]}"
elapsed=0

case "$RECONCILIATION_EXPECTATION" in
    present|absent) ;;
    *)
        echo "✗ Invalid RECONCILIATION_EXPECTATION [$RECONCILIATION_EXPECTATION]: expected present or absent"
        return 1
        ;;
esac

case "$VERIFY_SCOPE" in
    link)
        EXPECTED_PATHS="${RULE_PATHS:-[]}"
        ;;
    all)
        if ! INGRESS_JSON=$(kubectl get ingress "$INGRESS_NAME" -n "$K8S_NAMESPACE" -o json --ignore-not-found); then
            echo "✗ Failed to get ingress [$INGRESS_NAME]"
            return 1
        fi
        EXPECTED_PATHS=$(jq -c '[.spec.rules[]?.http.paths[]?.path] | unique' <<< "${INGRESS_JSON:-null}")
        ;;
    *)
        echo "✗ Invalid VERIFY_SCOPE [$VERIFY_SCOPE]: expected link or all"
        return 1
        ;;
esac

for paths in "$EXPECTED_PATHS" "$REMOVED_PATHS"; do
    if ! jq -e 'type == "array" and all(.[]; type == "string")' <<< "$paths" >/dev/null 2>&1; then
        echo "✗ Paths to verify must be a JSON array of strings, got [$paths]"
        return 1
    fi
done

if [ "$EXPECTED_PATHS" = "[]" ]; then
    echo "Waiting for ingress [$INGRESS_NAME] reconciliation..."
elif [ "$REMOVED_PATHS" = "[]" ]; then
    echo "Waiting for ingress [$INGRESS_NAME] reconciliation (paths $EXPECTED_PATHS expected $RECONCILIATION_EXPECTATION)..."
else
    echo "Waiting for ingress [$INGRESS_NAME] reconciliation (paths $EXPECTED_PATHS expected $RECONCILIATION_EXPECTATION, removed paths $REMOVED_PATHS expected absent)..."
fi

ALB_RECONCILIATION_ENABLED="${ALB_RECONCILIATION_ENABLED:-false}"

if [ "$ALB_RECONCILIATION_ENABLED" != "true" ] && [ "${IS_SERVICE_CREATION:-false}" != "true" ]; then
    echo "⚠ Skipping verification: ALB_RECONCILIATION_ENABLED is not true, so nothing is verified for paths $EXPECTED_PATHS. The controller aggregates its reconciliation event instead of emitting a new one, so only the ALB can confirm a rule update."

    return 0
fi

if [ "$ALB_RECONCILIATION_ENABLED" = "true" ]; then
    echo "Validating ALB [$ALB_NAME] configuration for domain [$EXPOSER_DOMAIN]"
elif [ "$EXPECTED_PATHS" = "[]" ]; then
    echo "ALB reconciliation disabled, will check the ingress reconciliation event only"
else
    echo "ALB reconciliation disabled, will check the ingress reconciliation event only: paths $EXPECTED_PATHS are not verified in the ALB"
fi

AWS_REGION_EFFECTIVE="${AWS_REGION:-${REGION:-}}"
if [ -z "$AWS_REGION_EFFECTIVE" ]; then
    echo "Error: AWS region is not set. Please set AWS_REGION (preferred) or REGION."
    exit 1
fi

if [ "$VERIFY_SCOPE" = "link" ] && ! INGRESS_JSON=$(kubectl get ingress "$INGRESS_NAME" -n "$K8S_NAMESPACE" -o json --ignore-not-found); then
    echo "✗ Failed to get ingress [$INGRESS_NAME]"
    return 1
fi

if [ -z "$INGRESS_JSON" ] && [ "$ALB_RECONCILIATION_ENABLED" != "true" ]; then
    echo "✓ Ingress [$INGRESS_NAME] does not exist, nothing to reconcile"
    return 0
fi

current_resource_version=$(echo "$INGRESS_JSON" | jq -r '.metadata.resourceVersion')

ingress_entry() {
    jq -c --arg path "$1" 'first(.spec.rules[]?.http.paths[]? | select(.path == $path)) // empty' <<< "$INGRESS_JSON"
}

backend_service() {
    jq -r '.backend.service.name // empty' <<< "$1"
}

backend_port_name() {
    jq -r '.backend.service.port.name // empty' <<< "$1"
}

annotation_action() {
    jq -c --arg key "alb.ingress.kubernetes.io/actions.$1" '.metadata.annotations[$key] // empty | fromjson? | objects' <<< "$INGRESS_JSON"
}

action_weights() {
    jq -r '.forwardConfig.targetGroups // .targetGroups // [] | map(.weight // 1) | sort | map(tostring) | join("/")' <<< "$1"
}

declared_paths() {
    jq -r 'unique[]' <<< "$EXPECTED_PATHS"
    if [ "$RECONCILIATION_EXPECTATION" = "absent" ] \
        && ! jq -e 'index("/")' <<< "$EXPECTED_PATHS" >/dev/null \
        && [ "$(backend_service "$(ingress_entry /)")" = "response-404" ]; then
        echo "/"
    fi
}

expected_kind() {
    local path="$1" entry service action weights
    if ! entry=$(ingress_entry "$path"); then
        return 1
    fi

    if [ -z "$entry" ]; then
        if [ "$RECONCILIATION_EXPECTATION" = "absent" ]; then
            echo "absent"
        else
            echo "error path is not in the ingress"
        fi
        return 0
    fi

    service=$(backend_service "$entry")
    if [ "$RECONCILIATION_EXPECTATION" = "absent" ] && { [ "$path" != "/" ] || [ "$service" != "response-404" ]; }; then
        echo "error path is still in the ingress"
        return 0
    fi

    if [ "$(backend_port_name "$entry")" != "use-annotation" ]; then
        echo "single"
        return 0
    fi

    action=$(annotation_action "$service")
    if [ -z "$action" ]; then
        echo "error annotation for action [$service] is missing or invalid"
        return 0
    fi

    case "$(jq -r '.type' <<< "$action")" in
        forward)
            weights=$(action_weights "$action")
            if [[ "$weights" == */* ]]; then
                echo "weights $weights"
            else
                echo "single"
            fi
            ;;
        fixed-response)
            echo "fixed-response $(jq -r '.fixedResponseConfig.statusCode // empty' <<< "$action")"
            ;;
        *)
            echo "exists"
            ;;
    esac
}

EXPECTED_PATH_LIST=()
EXPECTED_KINDS=()
EXPECTED_DETAILS=()
PATH_ERRORS=()

if [ "$ALB_RECONCILIATION_ENABLED" = "true" ]; then
    while IFS= read -r path; do
        if ! expectation=$(expected_kind "$path"); then
            echo "✗ Could not read the expected backends from ingress [$INGRESS_NAME]"
            return 1
        fi
        read -r kind detail <<< "$expectation"
        if [ "$kind" = "error" ]; then
            PATH_ERRORS+=("  - $path: $detail")
        else
            EXPECTED_PATH_LIST+=("$path")
            EXPECTED_KINDS+=("$kind")
            EXPECTED_DETAILS+=("$detail")
        fi
    done < <(declared_paths)
    while IFS= read -r path; do
        EXPECTED_PATH_LIST+=("$path")
        EXPECTED_KINDS+=("absent")
        EXPECTED_DETAILS+=("")
    done < <(jq -r '.[]' <<< "$REMOVED_PATHS")
fi

if [ "${#PATH_ERRORS[@]}" -gt 0 ]; then
    echo "✗ Cannot verify the ALB for ingress [$INGRESS_NAME]:"
    printf '%s\n' "${PATH_ERRORS[@]}"
    return 1
fi

if [ "$RECONCILIATION_EXPECTATION" = "absent" ] && [ "${#EXPECTED_PATH_LIST[@]}" -eq 0 ]; then
    echo "✓ No paths to verify as removed"
    return 0
fi

LINK_NAMES=""

if [ "$ALB_RECONCILIATION_ENABLED" = "true" ] && [ -n "$INGRESS_JSON" ]; then
    if ! LINK_REFS=$(ingress_service_refs "$EXPECTED_PATHS" <<< "$INGRESS_JSON" 2>&1); then
        echo "✗ Could not read the services referenced by paths $EXPECTED_PATHS in ingress [$INGRESS_NAME]: ${LINK_REFS##*$'\n'}"
        return 1
    fi

    while IFS= read -r path; do
        LINK_NAMES+="$(backend_service "$(ingress_entry "$path")")"$'\n'
    done < <(jq -r '.[]' <<< "$EXPECTED_PATHS")
    LINK_NAMES+=$(cut -f3 <<< "$LINK_REFS")
fi

if [ "$ALB_RECONCILIATION_ENABLED" = "true" ]; then
    if ! ALB_ARN=$(aws elbv2 describe-load-balancers \
            --names "$ALB_NAME" \
            --region "$AWS_REGION_EFFECTIVE" \
            --query 'LoadBalancers[0].LoadBalancerArn' \
            --output text 2>&1); then
        echo "✗ Could not describe ALB [$ALB_NAME] in region [$AWS_REGION_EFFECTIVE]"
        echo "  $ALB_ARN"
        return 1
    fi

    if [ "$ALB_ARN" == "None" ] || [ -z "$ALB_ARN" ]; then
        echo "✗ No ALB named [$ALB_NAME] in region [$AWS_REGION_EFFECTIVE]"
        return 1
    fi
fi

ALB_CONDITION_VALUES_JQ='def condition_values(field): [.Conditions[]? | select(.Field == field) | ((.Values // []) + (.HostHeaderConfig.Values // []) + (.PathPatternConfig.Values // []))[]];'
ALB_RULE_WEIGHTS_JQ='[.Actions[]? | select(.Type == "forward") | (.ForwardConfig.TargetGroups // [select(.TargetGroupArn)])[] | .Weight // 1]'

path_patterns() {
    local base="$1"
    if [ "$base" = "/" ]; then
        echo '["/*"]'
        return 0
    fi
    while [ "$base" != "${base%/}" ]; do
        base="${base%/}"
    done
    jq -nc --arg base "$base" '[$base, $base + "/*"]'
}

alb_rules_for_path() {
    jq -c --arg domain "$EXPOSER_DOMAIN" --argjson patterns "$(path_patterns "$2")" "$ALB_CONDITION_VALUES_JQ"'
        map(select((condition_values("host-header") | index($domain)) != null
            and any(condition_values("path-pattern")[]; IN($patterns[]))
            and all(.Actions[]?; .Type != "redirect")))' <<< "$1"
}

domain_has_rules() {
    jq -e --arg domain "$EXPOSER_DOMAIN" "$ALB_CONDITION_VALUES_JQ"' any(.[]; condition_values("host-header") | index($domain) != null)' <<< "$1" >/dev/null
}

rule_count() {
    jq 'length' <<< "$1"
}

rule_target_group_counts() {
    jq -r ".[] | $ALB_RULE_WEIGHTS_JQ | length" <<< "$1"
}

rule_weights() {
    jq -r ".[] | $ALB_RULE_WEIGHTS_JQ | sort | map(tostring) | join(\"/\")" <<< "$1"
}

check_absent() {
    if [ "$(rule_count "$1")" -eq 0 ]; then
        echo "removed from ALB"
        return 0
    fi
    echo "still present in ALB"
    return 1
}

check_single() {
    local counts
    counts=$(rule_target_group_counts "$1")
    if [ "$(sort -u <<< "$counts")" = "1" ]; then
        echo "single target group"
        return 0
    fi
    echo "expected 1 target group, found ${counts//$'\n'//}"
    return 1
}

check_weights() {
    local expected="$1" actual
    actual=$(rule_weights "$2")
    if [ "$(sort -u <<< "$actual")" = "$expected" ]; then
        echo "weights $expected"
        return 0
    fi
    echo "weights mismatch: expected=$expected actual=${actual//$'\n'/,}"
    return 1
}

check_fixed_response() {
    local status="$1"
    if jq -e --arg status "$status" 'all(.[]; any(.Actions[]?; .Type == "fixed-response" and ($status == "" or .FixedResponseConfig.StatusCode == $status)))' <<< "$2" >/dev/null; then
        echo "fixed response $status"
        return 0
    fi
    echo "expected fixed response $status"
    return 1
}

check_path() {
    local kind="$1" detail="$2" rules="$3"
    if [ "$kind" = "absent" ]; then
        check_absent "$rules"
        return
    fi

    if [ "$(rule_count "$rules")" -eq 0 ]; then
        echo "missing rule"
        return 1
    fi

    case "$kind" in
        single) check_single "$rules" ;;
        weights) check_weights "$detail" "$rules" ;;
        fixed-response) check_fixed_response "$detail" "$rules" ;;
        *) echo "rule present" ;;
    esac
}

validate_alb_config() {
    local listeners listener_arns listener_arn rules all_rules i path detail report="" all_ok=true

    if ! listeners=$(aws elbv2 describe-listeners \
            --load-balancer-arn "$ALB_ARN" \
            --region "$AWS_REGION_EFFECTIVE" \
            --output json 2>&1); then
        echo "✗ Could not get listeners for ALB [$ALB_NAME]"
        echo "  $listeners"
        return 1
    fi

    if ! listener_arns=$(jq -r '.Listeners[].ListenerArn' <<< "$listeners"); then
        echo "✗ Could not parse listeners for ALB [$ALB_NAME]"
        return 1
    fi

    all_rules="[]"
    for listener_arn in $listener_arns; do
        if ! rules=$(aws elbv2 describe-rules \
                --listener-arn "$listener_arn" \
                --region "$AWS_REGION_EFFECTIVE" \
                --output json 2>&1); then
            echo "✗ Could not get rules for listener [$listener_arn]"
            echo "  $rules"
            return 1
        fi

        if ! all_rules=$(echo "$all_rules" "$rules" | jq -sc '.[0] + .[1].Rules'); then
            echo "✗ Could not parse rules for listener [$listener_arn]"
            return 1
        fi
    done

    echo "Checking domain: $EXPOSER_DOMAIN"

    if [ -z "$INGRESS_JSON" ]; then
        if ! domain_has_rules "$all_rules"; then
            echo "✓ No rules for the domain are left in ALB"
            return 0
        fi

        echo "  ✗ Domain still in ALB rules: $EXPOSER_DOMAIN"
        return 2
    fi

    if [ "${#EXPECTED_PATH_LIST[@]}" -eq 0 ]; then
        if domain_has_rules "$all_rules"; then
            echo "✓ Domain rule is configured in ALB"
            return 0
        fi

        echo "  ✗ Domain not found in ALB rules: $EXPOSER_DOMAIN"
        return 2
    fi

    for i in "${!EXPECTED_PATH_LIST[@]}"; do
        path="${EXPECTED_PATH_LIST[$i]}"
        if ! rules=$(alb_rules_for_path "$all_rules" "$path"); then
            echo "✗ Could not evaluate ALB rules"
            return 1
        fi

        if detail=$(check_path "${EXPECTED_KINDS[$i]}" "${EXPECTED_DETAILS[$i]}" "$rules"); then
            report+="  ✓ $path: $detail"$'\n'
        else
            report+="  ✗ $path: $detail"$'\n'
            all_ok=false
        fi
    done

    echo "${report%$'\n'}"

    if [ "$all_ok" = "true" ]; then
        echo "✓ All expected rules are reconciled in ALB"
        return 0
    fi

    echo "⚠ The ALB does not reflect the expected rules yet"
    return 2
}

mentions_link() {
    local name
    while IFS= read -r name; do
        if [ -n "$name" ] && [[ "$1" =~ (^|[^A-Za-z0-9_-])"$name"($|[^A-Za-z0-9_-]) ]]; then
            return 0
        fi
    done <<< "$LINK_NAMES"
    return 1
}

is_attributable() {
    local reason="$1" message="$2"
    [ "$ALB_RECONCILIATION_ENABLED" != "true" ] \
        || [ "$reason" = "ConflictingIngressClass" ] \
        || [[ "$message" == *"no certificate found for host"* ]] \
        || mentions_link "$message"
}

active_failures() {
    jq -r --arg since "$2" '.[] | select(.lastTimestamp > $since) | [.reason, .message] | @tsv' <<< "$1"
}

if [ -z "$INGRESS_JSON" ]; then
    echo "Ingress [$INGRESS_NAME] does not exist, waiting until no ALB rule has domain [$EXPOSER_DOMAIN]"
    while [ "$elapsed" -lt "$MAX_WAIT_SECONDS" ]; do
        if validate_alb_config; then
            echo "✓ ALB configuration validated successfully"
            return 0
        else
            alb_status=$?
        fi

        if [ "$alb_status" -ne 2 ]; then
            return 1
        fi

        echo "Waiting for ALB reconciliation... (${elapsed}s/${MAX_WAIT_SECONDS}s)"
        sleep "$CHECK_INTERVAL"
        elapsed=$((elapsed + CHECK_INTERVAL))
    done

    echo "✗ Timeout waiting for the ALB to drop the rules of domain [$EXPOSER_DOMAIN] after ${MAX_WAIT_SECONDS} seconds"
    echo "Check the ALB Ingress Controller logs: kubectl logs -n kube-system -l app.kubernetes.io/name=aws-load-balancer-controller"
    exit 1
fi

LOGGED_CONTEXT=""

while [ "$elapsed" -lt "$MAX_WAIT_SECONDS" ]; do
    if [ "$ALB_RECONCILIATION_ENABLED" = "true" ]; then
        if validate_alb_config; then
            echo "✓ ALB configuration validated successfully"
            return 0
        else
            alb_status=$?
        fi

        if [ "$alb_status" -ne 2 ]; then
            return 1
        fi

        echo "ALB validation incomplete, checking Kubernetes events..."
    fi

    events_json=$(kubectl get events -n "$K8S_NAMESPACE" \
        --field-selector "involvedObject.name=$INGRESS_NAME,involvedObject.kind=Ingress" \
        -o json)

    relevant_events=$(echo "$events_json" | jq --arg rv "$current_resource_version" '
          .items | map(select((.involvedObject.resourceVersion | tonumber) >= ($rv | tonumber)))
      ')

    event_count=$(echo "$relevant_events" | jq 'length')

    if [ "$event_count" -gt 0 ]; then
        failures=$(echo "$relevant_events" | jq -c '[.[] | select(.reason | test("^Failed|^ConflictingIngressClass"))]')

        latest_failure=$(echo "$failures" | jq -r 'sort_by(.lastTimestamp) | last.lastTimestamp // empty')
        latest_success=$(echo "$relevant_events" | jq -r '[.[] | select(.reason == "SuccessfullyReconciled")] | sort_by(.lastTimestamp) | last.lastTimestamp // empty')

        attributable=""
        context=""
        if [ -n "$latest_failure" ] && { [ -z "$latest_success" ] || [[ "$latest_failure" > "$latest_success" ]]; }; then
            while IFS=$'\t' read -r reason message; do
                line="  - [$reason] $message"
                if is_attributable "$reason" "$message"; then
                    attributable+="$line"$'\n'
                elif [[ $'\n'"$LOGGED_CONTEXT" != *$'\n'"$line"$'\n'* ]]; then
                    context+="$line"$'\n'
                    LOGGED_CONTEXT+="$line"$'\n'
                fi
            done < <(active_failures "$failures" "$latest_success")

            if [ -n "$context" ]; then
                echo "Failure events not attributable to paths $EXPECTED_PATHS, still waiting for the ALB:"
                echo "${context%$'\n'}"
            fi
        fi

        if [ -n "$attributable" ]; then
            echo "✗ The ingress could not be reconciled"
            echo "${attributable%$'\n'}"

            if [[ "$attributable" == *"no certificate found for host"* ]]; then
                echo "Root cause: The ingress hostname does not match any available SSL/TLS certificate"
                echo "To fix this issue:"
                echo "  1. Verify the hostname in your ingress matches a certificate in ACM (AWS Certificate Manager)"
                echo "  2. Check the 'alb.ingress.kubernetes.io/certificate-arn' annotation points to a valid certificate"
                echo "  3. Ensure the certificate includes the exact hostname or a wildcard that covers it"
            fi

            exit 1
        fi

        if [ -n "$latest_success" ] && { [ -z "$latest_failure" ] || [[ "$latest_success" > "$latest_failure" ]]; }; then
            if [ "$ALB_RECONCILIATION_ENABLED" = "true" ]; then
                echo "Ingress reported as reconciled, but the ALB does not reflect the expected rules yet"
            else
                echo "✓ Ingress was successfully reconciled (via event)"
                return 0
            fi
        fi
    fi

    if [ "$ALB_RECONCILIATION_ENABLED" = "true" ]; then
        echo "Waiting for ALB reconciliation... (${elapsed}s/${MAX_WAIT_SECONDS}s)"
    else
        echo "Waiting for the ingress reconciliation event... (${elapsed}s/${MAX_WAIT_SECONDS}s)"
    fi
    sleep "$CHECK_INTERVAL"
    elapsed=$((elapsed + CHECK_INTERVAL))
done

# Timeout reached - show diagnostic information
echo "✗ Timeout waiting for ingress reconciliation after ${MAX_WAIT_SECONDS} seconds"
echo ""
echo "Diagnostic information:"
echo "1. Check ALB Ingress Controller logs:"
echo "   kubectl logs -n kube-system -l app.kubernetes.io/name=aws-load-balancer-controller"
echo ""
echo "2. Check ingress status:"
echo "   kubectl describe ingress $INGRESS_NAME -n $K8S_NAMESPACE"
echo ""
echo "3. Recent events:"
events_json=$(kubectl get events -n "$K8S_NAMESPACE" \
    --field-selector "involvedObject.name=$INGRESS_NAME,involvedObject.kind=Ingress" \
    -o json)
recent_events=$(echo "$events_json" | jq -r '.items | sort_by(.lastTimestamp) | .[] | "  [\(.type)] \(.reason): \(.message)"' | tail -10)
echo "${recent_events:-   none}"

exit 1
