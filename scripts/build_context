#!/bin/bash

set -euo pipefail

SERVICE_ID=$(echo "$CONTEXT" | jq -r .service.id)
SERVICE_NAME=$(echo "$CONTEXT" | jq -r .service.slug)

ACTION_ID=$(echo "$CONTEXT" | jq -r .id)
ACTION_NAME=$(echo "$CONTEXT" | jq -r .slug)

LINK_ID=$(echo "$CONTEXT" | jq -r .link.id)
LINK_NAME=$(echo "$CONTEXT" | jq -r .link.slug)

CONTEXT=$(echo "$CONTEXT" | jq \
          --arg k8s_namespace "$K8S_NAMESPACE" \
          --arg alb_name "$ALB_NAME" \
          --arg visibility "$VISIBILITY" \
          '. + {k8s_namespace: $k8s_namespace, alb_name: $alb_name, visibility: $visibility}')

SCOPE_ID=$(echo "$CONTEXT" | jq -r .tags.scope_id)
SCOPE_SLUG=$(echo "$CONTEXT" | jq -r .tags.scope)

STORED_ATTRIBUTES=$(echo "$CONTEXT" | jq -c 'if .type == "create" then {} else (.link.attributes // {}) end')
SUBMITTED_ATTRIBUTES=$(echo "$CONTEXT" | jq -c '.parameters // {}')
LINK_ATTRIBUTES=$(echo "$CONTEXT" | jq -c --argjson stored "$STORED_ATTRIBUTES" --argjson submitted "$SUBMITTED_ATTRIBUTES" '
  # Unlink removes what the link persisted, not whatever the delete request submitted.
  # Refresh re-applies what the link persisted: its workflow skips the uniqueness check,
  # so a submitted path must never reach it or it would take over the route of another scope.
  if (.type == "delete" and $stored != {}) or .slug == "refresh" then $stored else $stored * $submitted end
')

IS_SERVICE_CREATION=$(echo "$CONTEXT" | jq -r '.type == "create"')

RULE_PATH=$(echo "$LINK_ATTRIBUTES" | jq -r '.path')

RULE_PATHS=$(echo "$LINK_ATTRIBUTES" | jq -c '
  [ .path ] + (.additional_paths // [])
  | map(select(. != null and . != ""))
')

PREVIOUS_RULE_PATHS=$(echo "$STORED_ATTRIBUTES" | jq -c '
  [ .path ] + (.additional_paths // [])
  | map(select(. != null and . != ""))
')

export OUTPUT_DIR="$SERVICE_PATH/output/$SERVICE_NAME-$SERVICE_ID/$ACTION_NAME-$ACTION_ID"

mkdir -p "$OUTPUT_DIR"

export SERVICE_ID
export SERVICE_NAME
export ACTION_ID
export ACTION_NAME
export LINK_ID
export LINK_NAME
export SCOPE_ID
export SCOPE_SLUG
export RULE_PATH
export RULE_PATHS
export PREVIOUS_RULE_PATHS
export IS_SERVICE_CREATION
