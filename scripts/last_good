#!/bin/bash

if ! declare -F lease_assert_held >/dev/null && ! LEASE_LIB_ONLY=true source "$(dirname "${BASH_SOURCE[0]}")/lease"; then
  echo "Error: could not load the Lease functions from $(dirname "${BASH_SOURCE[0]}")/lease"
  return 1
fi

last_good_name() {
  echo "exposer-$SERVICE_ID-last-good"
}

last_good_ingress_name() {
  echo "k-8-s-$SERVICE_NAME-$SERVICE_ID-public"
}

last_good_read() {
  local errors snapshot message rc=0
  if ! errors=$(mktemp); then
    echo "Error: could not create a temporary file to read the last good snapshot" >&2
    return 1
  fi
  snapshot=$(kubectl get configmap "$(last_good_name)" -n "$K8S_NAMESPACE" -o json 2>"$errors" </dev/null) || rc=$?
  message=$(<"$errors")
  rm -f "$errors"
  if (( rc != 0 )); then
    if [[ "$message" == *"(NotFound)"* ]]; then
      return 2
    fi
    echo "Error: could not read the last good snapshot $(last_good_name) in namespace $K8S_NAMESPACE: ${message:-kubectl exited with $rc}" >&2
    return 1
  fi
  printf '%s\n' "$snapshot"
}

last_good_clean_ingress() {
  jq -c '{
    apiVersion,
    kind,
    metadata: {
      name: .metadata.name,
      namespace: .metadata.namespace,
      labels: (.metadata.labels // {}),
      annotations: ((.metadata.annotations // {}) | del(.["kubectl.kubernetes.io/last-applied-configuration"]))
    },
    spec
  }'
}

last_good_manifest() {
  local ingress="$1" resource_version="$2"
  jq -n \
    --arg name "$(last_good_name)" \
    --arg namespace "$K8S_NAMESPACE" \
    --arg service_id "$SERVICE_ID" \
    --arg resource_version "$resource_version" \
    --arg ingress "$ingress" \
    --arg action "$ACTION_NAME" \
    --arg action_id "$ACTION_ID" \
    --arg token "$LEASE_TOKEN" \
    --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{
    apiVersion: "v1",
    kind: "ConfigMap",
    metadata: {name: $name, namespace: $namespace, labels: {nullplatform: "true", service_id: $service_id}},
    data: {ingress: $ingress, action: $action, action_id: $action_id, token: $token, date: $date}
  }
  | if $resource_version == "" then . else .metadata.resourceVersion = $resource_version end'
}

last_good_token() {
  jq -r '.data.token // "0"' <<<"$1"
}

last_good_save() {
  local ingress_name live snapshot saved resource_version verb reason file rc
  if [[ ! "${LEASE_TOKEN-}" =~ ^[0-9]+$ ]]; then
    echo "Error: LEASE_TOKEN is not set; take the Lease before saving the last good snapshot"
    return 1
  fi
  ingress_name=$(last_good_ingress_name)
  if ! live=$(kubectl get ingress "$ingress_name" -n "$K8S_NAMESPACE" -o json); then
    echo "Error: could not read ingress [$ingress_name] to save the last good snapshot"
    return 1
  fi
  file="$OUTPUT_DIR/$(last_good_name).json"
  while true; do
    rc=0
    snapshot=$(last_good_read) || rc=$?
    if (( rc == 1 )); then
      return 1
    fi
    verb=create
    reason=AlreadyExists
    resource_version=""
    if (( rc == 0 )); then
      saved=$(last_good_token "$snapshot")
      if [[ ! "$saved" =~ ^[0-9]+$ ]]; then
        echo "Error: the last good snapshot $(last_good_name) has an invalid token '$saved'"
        return 1
      fi
      if (( saved >= LEASE_TOKEN )); then
        echo "Kept the last good snapshot $(last_good_name): its token $saved is not older than this action's token $LEASE_TOKEN"
        return 0
      fi
      verb=replace
      reason=Conflict
      resource_version=$(jq -r '.metadata.resourceVersion' <<<"$snapshot")
    fi
    if ! last_good_manifest "$(last_good_clean_ingress <<<"$live")" "$resource_version" > "$file"; then
      echo "Error: could not build the last good snapshot of ingress [$ingress_name]"
      return 1
    fi
    if ! lease_assert_held 10; then
      return 1
    fi
    rc=0
    lease_kubectl "$reason" "$verb" -f "$file" || rc=$?
    if (( rc == 0 )); then
      echo "✓ Saved ingress [$ingress_name] as the last good snapshot $(last_good_name) (token $LEASE_TOKEN)"
      return 0
    fi
    if (( rc == 1 )); then
      echo "Error: could not save the last good snapshot $(last_good_name)"
      return 1
    fi
    echo "The last good snapshot $(last_good_name) changed meanwhile; reading it again"
  done
}

last_good_delete() {
  if ! kubectl delete configmap "$(last_good_name)" -n "$K8S_NAMESPACE" --ignore-not-found; then
    echo "Error: could not delete the last good snapshot $(last_good_name)"
    return 1
  fi
}

last_good_main() {
  case "${LAST_GOOD_ACTION-}" in
    save)
      if [[ "${ALB_RECONCILIATION_ENABLED:-false}" != "true" ]]; then
        echo "⚠ Skipping the last good snapshot: ALB_RECONCILIATION_ENABLED is not true, so the ingress was not verified in the ALB"
        return 0
      fi
      last_good_save
      ;;
    delete)
      last_good_delete
      ;;
    *)
      echo "Error: LAST_GOOD_ACTION must be save or delete, got '${LAST_GOOD_ACTION-}'"
      return 1
      ;;
  esac
}

case "${LAST_GOOD_LIB_ONLY-false}" in
  true)
    return 0
    ;;
  false)
    ;;
  *)
    echo "Error: LAST_GOOD_LIB_ONLY must be true or false, got '$LAST_GOOD_LIB_ONLY'"
    exit 1
    ;;
esac

set -euo pipefail

if ! last_good_main; then
  exit 1
fi
