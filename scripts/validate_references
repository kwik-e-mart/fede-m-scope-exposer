#!/bin/bash

if ! source "$(dirname "${BASH_SOURCE[0]}")/validate_references_lib"; then
  echo "Error: could not load validate_references_lib from $(dirname "${BASH_SOURCE[0]}")"
  exit 1
fi

validate_references_main() {
  local required ingress rc=0
  for required in INGRESS_FILE RULE_PATHS K8S_NAMESPACE; do
    if [[ -z "${!required-}" ]]; then
      echo "Error: $required is empty"
      return 1
    fi
  done
  if [[ ! -f "$INGRESS_FILE" ]]; then
    echo "Error: rendered ingress $INGRESS_FILE does not exist"
    return 1
  fi
  if ! ingress=$(yq -o=json '.' "$INGRESS_FILE"); then
    echo "Error: could not read the rendered ingress $INGRESS_FILE"
    return 1
  fi
  echo "Validating the services referenced by paths $RULE_PATHS"
  validate_references_for_ingress "$ingress" "$RULE_PATHS" || rc=$?
  case "$rc" in
    0)
      return 0
      ;;
    2)
      echo "Error: the link references services that do not exist or do not expose the port. The ingress was not applied; deploy the scope and refresh the link."
      return 1
      ;;
    *)
      echo "The ingress was not applied; retry once the cause above is fixed."
      return 1
      ;;
  esac
}

set -euo pipefail

if ! validate_references_main; then
  exit 1
fi
