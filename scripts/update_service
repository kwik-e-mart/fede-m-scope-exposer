#!/bin/bash

set -euo pipefail

if [[ "$ACTION" == "sync" ]]; then
  UPDATED_ATTRIBUTES=$(echo "$CONTEXT" | jq --argjson paths "$RULE_PATHS" --arg scope "$SCOPE_SLUG" '
    .service.attributes |= (
      .rules = ((.rules // []) | map(select(.scope != $scope)) + ($paths | map({path: ., scope: $scope})))
    ) |
    {
      attributes: .service.attributes,
      entity_nrn: (.entity_nrn | sub(":scope=[^:]+$"; ""))
    }
  ')
elif [[ "$ACTION" == "remove" ]]; then
  UPDATED_ATTRIBUTES=$(echo "$CONTEXT" | jq --argjson paths "$RULE_PATHS" --arg scope "$SCOPE_SLUG" '
    .service.attributes |= (
      .rules = ((.rules // []) | map(select(.scope != $scope or (.path as $path | $paths | index($path) == null))))
    ) |
    {
      attributes: .service.attributes,
      entity_nrn: (.entity_nrn | sub(":scope=[^:]+$"; ""))
    }
  ')
else
  echo "Error: unknown ACTION '$ACTION'"
  exit 1
fi

np service patch --id "$SERVICE_ID" --body "$UPDATED_ATTRIBUTES"
