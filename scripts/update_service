#!/bin/bash

set -euo pipefail

if ! SERVICE=$(np service read --id "$SERVICE_ID" --format json) || ! echo "$SERVICE" | jq -e 'type == "object"' >/dev/null 2>&1; then
  echo "Error: could not read service $SERVICE_ID to update its rules; the service was not patched"
  exit 1
fi

ENTITY_NRN=$(echo "$CONTEXT" | jq -r '.entity_nrn | sub(":scope=[^:]+$"; "")')

if [[ "$ACTION" == "sync" ]]; then
  UPDATED_ATTRIBUTES=$(echo "$SERVICE" | jq --argjson paths "$RULE_PATHS" --argjson previous "$PREVIOUS_RULE_PATHS" --arg scope "$SCOPE_SLUG" --arg nrn "$ENTITY_NRN" '
    .attributes |= (
      .rules = ((.rules // [])
        | map(select(.path as $path | ($previous + $paths) | index($path) == null))
        + ($paths | map({path: ., scope: $scope})))
    ) |
    {
      attributes: .attributes,
      entity_nrn: $nrn
    }
  ')
elif [[ "$ACTION" == "remove" ]]; then
  UPDATED_ATTRIBUTES=$(echo "$SERVICE" | jq --argjson paths "$RULE_PATHS" --arg nrn "$ENTITY_NRN" '
    .attributes |= (
      .rules = ((.rules // []) | map(select(.path as $path | $paths | index($path) == null)))
    ) |
    {
      attributes: .attributes,
      entity_nrn: $nrn
    }
  ')
elif [[ "$ACTION" == "rebuild" ]]; then
  echo "Realigning the service rules with the published paths: $REBUILT_RULES"
  UPDATED_ATTRIBUTES=$(echo "$SERVICE" | jq --argjson rules "$REBUILT_RULES" --arg nrn "$ENTITY_NRN" '
    .attributes.rules = $rules |
    {
      attributes: .attributes,
      entity_nrn: $nrn
    }
  ')
else
  echo "Error: unknown ACTION '$ACTION'"
  exit 1
fi

np service patch --id "$SERVICE_ID" --body "$UPDATED_ATTRIBUTES"
