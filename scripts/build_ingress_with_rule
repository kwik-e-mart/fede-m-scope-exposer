#!/bin/bash

set -euo pipefail

if [[ "$RULE_PATHS" == "[]" ]]; then
  echo "Error: the link does not declare any non-empty path"
  exit 1
fi

ENTRY_DEFS=$(cat "$SERVICE_PATH/scripts/ingress_entry.jq")

ENTRY_PATH=$(jq -nr --argjson desired "$RULE_PATHS" "$ENTRY_DEFS"' entry_path($desired)')

if [[ "$(echo "$RULE_PATHS" | jq 'length')" -gt 1 && "${#ENTRY_PATH}" -gt 128 ]]; then
  echo "Error: the declared paths need ${#ENTRY_PATH} characters as a single ALB path pattern, and the limit is 128. Declare fewer or shorter paths."
  exit 1
fi

INGRESS_NAME=$(kubectl get ingress -n "$K8S_NAMESPACE" -l "service_id=$SERVICE_ID" -o jsonpath="{.items[0].metadata.name}")
INGRESS=$(kubectl get ingress -n "$K8S_NAMESPACE" "$INGRESS_NAME" -o json)

ANNOTATION=$(echo "$SCOPE_RULE" | jq -r .blue_green_annotation)
SERVICE=$(echo "$SCOPE_RULE" | jq .service)

if [[ "$ANNOTATION" != "null" && -n "$ANNOTATION" ]]; then
  SERVICE=$(echo "$SERVICE" | jq --arg scope_id "$SCOPE_ID" '.name = "bg-deployment-" + $scope_id')
fi

PUBLISHED_PATHS=$(echo "$CONTEXT" | jq -c --arg scope "$SCOPE_SLUG" '
  (.service.attributes.rules // []) | map(select(.scope == $scope) | .path)
')

ANNOTATION_KEY="alb.ingress.kubernetes.io/actions.bg-deployment-$SCOPE_ID"

echo "Publishing paths $RULE_PATHS for scope $SCOPE_ID as $ENTRY_PATH"

UPDATED_INGRESS=$(echo "$INGRESS" | jq \
  --argjson desired "$RULE_PATHS" \
  --argjson published "$PUBLISHED_PATHS" \
  --argjson service "$SERVICE" \
  --arg annotation_key "$ANNOTATION_KEY" \
  --arg annotation "$ANNOTATION" \
  "$ENTRY_DEFS"'
  owned_entry_paths($published; $desired) as $owned
  | { path: entry_path($desired), pathType: entry_type($desired), backend: { service: $service } } as $entry
  | .spec.rules[0].http.paths |= (
      map(select(.backend.service.name != "response-404"))
      | ([ range(0; length) as $i | select(.[$i].path as $p | $owned | index($p) != null) | $i ] | first) as $at
      | (map(select(.path as $p | $owned | index($p) == null))) as $rest
      | if $at == null then $rest + [$entry] else $rest[0:$at] + [$entry] + $rest[$at:] end
    )
  | .metadata.annotations |= (
      del(.[$annotation_key])
      | .["alb.ingress.kubernetes.io/use-regex-path-match"] = "true"
      | if $annotation == "null" or $annotation == "" then . else .[$annotation_key] = $annotation end
    )
')

mkdir -p "$OUTPUT_DIR"
INGRESS_FILE="$OUTPUT_DIR/ingress-$SERVICE_ID-$SCOPE_ID-public.yaml"

echo "$UPDATED_INGRESS" | yq eval -P '.' > "$INGRESS_FILE"

echo "Ingress configuration saved to: $INGRESS_FILE"
