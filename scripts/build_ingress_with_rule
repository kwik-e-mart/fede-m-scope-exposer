#!/bin/bash

set -euo pipefail

INGRESS_NAME=$(kubectl get ingress -n "$K8S_NAMESPACE" -l "service_id=$SERVICE_ID" -o jsonpath="{.items[0].metadata.name}")
INGRESS=$(kubectl get ingress -n "$K8S_NAMESPACE" "$INGRESS_NAME" -o json)

ANNOTATION=$(echo "$SCOPE_RULE" | jq -r .blue_green_annotation)
SERVICE=$(echo "$SCOPE_RULE" | jq .service)

if [[ "$ANNOTATION" != "null" && -n "$ANNOTATION" ]]; then
  SERVICE=$(echo "$SERVICE" | jq --arg scope_id "$SCOPE_ID" '.name = "bg-deployment-" + $scope_id')
fi

STALE_PATHS=$(echo "$CONTEXT" | jq -c --arg scope "$SCOPE_SLUG" --argjson desired "$RULE_PATHS" '
  (.service.attributes.rules // [])
  | map(select(.scope == $scope) | .path)
  | map(select(. as $p | $desired | index($p) == null))
')

echo "Publishing paths $RULE_PATHS for scope $SCOPE_ID"

if [[ "$STALE_PATHS" != "[]" ]]; then
  echo "Removing paths $STALE_PATHS, no longer declared by the link"
fi

ANNOTATION_KEY="alb.ingress.kubernetes.io/actions.bg-deployment-$SCOPE_ID"

UPDATED_INGRESS=$(echo "$INGRESS" | jq \
  --argjson desired "$RULE_PATHS" \
  --argjson stale "$STALE_PATHS" \
  --argjson service "$SERVICE" \
  --arg annotation_key "$ANNOTATION_KEY" \
  --arg annotation "$ANNOTATION" '
  def rule($path): {path: $path, pathType: "Prefix", backend: {service: $service}};

  .spec.rules[0].http.paths |= (
    map(select(.backend.service.name != "response-404"))
    | map(select(.path as $path | $stale | index($path) == null))
    | reduce $desired[] as $path (.;
        (map(.path) | index($path)) as $index
        | if $index == null then . + [rule($path)] else .[$index] = rule($path) end
      )
  )
  | .metadata.annotations |= (
      del(.[$annotation_key])
      | if $annotation == "null" or $annotation == "" then . else .[$annotation_key] = $annotation end
    )
')

mkdir -p "$OUTPUT_DIR"
INGRESS_FILE="$OUTPUT_DIR/ingress-$SERVICE_ID-$SCOPE_ID-public.yaml"

echo "$UPDATED_INGRESS" | yq eval -P '.' > "$INGRESS_FILE"

echo "Ingress configuration saved to: $INGRESS_FILE"
