#!/bin/bash

# Drops the ingress rules whose path no longer has an active link behind it.
#
# Why this is needed: every link action edits ONE rule, locating it by path. If a
# link changes its path, or is removed through a route that does not match the
# path written in the rule, that rule is left with no owner: no refresh reaches
# it and no action deletes it. It keeps the Service it was pointing at that day,
# and the next finalize deletes that Service.
#
# Runs after build_ingress_with_rule and before apply: it edits the file that
# script left in OUTPUT_DIR, never the live cluster object.
#
# Two knobs make the same script usable from update and unlink, where the
# platform's view of the link and the intent of the action disagree:
#
#   EXCLUDE_LINK_ID  drop this link's path from the keep-list, whatever the API
#                    says it currently is. Used by unlink (the link is still
#                    active while its delete action runs) and by update (the old
#                    path must go regardless of whether the rename was persisted
#                    before the action started).
#   EXTRA_PATH       keep this path even if it is not in the active list yet.
#                    Used by update for the new path, and by create if ever
#                    wired there, since the link may still be pending_create.
#
# Together they make the outcome independent of when the platform persists the
# link: both orderings converge on the same ingress.

INGRESS_FILE="$OUTPUT_DIR/ingress-$SERVICE_ID-$SCOPE_ID-public.yaml"

if [ ! -f "$INGRESS_FILE" ]; then
  echo "⚠ No ingress file to prune at $INGRESS_FILE, skipping"
  return 0
fi

LINKS=$(np link list --service-id "$SERVICE_ID" --status active --all --format json 2>&1)

if [ $? -ne 0 ]; then
  echo "⚠ Could not list links for service $SERVICE_ID, skipping the prune"
  echo "  Response: $LINKS"
  return 0
fi

# The guard is evaluated on the raw response, before the knobs are applied.
# Otherwise deleting a service's last link — which legitimately leaves the
# ingress with no paths — would be indistinguishable from the API answering
# nothing, and the prune would refuse exactly when it is needed.
RAW_COUNT=$(jq '[.results[]?.attributes.path | select(. != null)] | length' <<< "$LINKS" 2>/dev/null)

if [ -z "$RAW_COUNT" ] || [ "$RAW_COUNT" -eq 0 ]; then
  echo "⚠ No active links reported for service $SERVICE_ID, skipping the prune"
  return 0
fi

ACTIVE_PATHS=$(jq -c \
  --arg exclude "${EXCLUDE_LINK_ID:-}" \
  --arg extra "${EXTRA_PATH:-}" '
    [ .results[]?
      | select($exclude == "" or (.id // "") != $exclude)
      | .attributes.path
      | select(. != null)
    ]
    + (if $extra == "" then [] else [$extra] end)
    | unique
  ' <<< "$LINKS" 2>/dev/null)

if [ -z "$ACTIVE_PATHS" ]; then
  echo "⚠ Could not read the link paths, skipping the prune"
  return 0
fi

BEFORE=$(yq '.spec.rules[0].http.paths | length' "$INGRESS_FILE")

PRUNED=$(yq -o=json '.' "$INGRESS_FILE" | jq --argjson keep "$ACTIVE_PATHS" '
  .spec.rules[0].http.paths |= map(
    select(
      ((.path // "") as $p | $keep | index($p)) != null
      or (.backend.service.name // "") == "response-404"
    )
  )
  | if (.spec.rules[0].http.paths | length) == 0 then
      .spec.rules[0].http.paths = [{
        path: "/",
        pathType: "Prefix",
        backend: { service: { name: "response-404", port: { name: "use-annotation" } } }
      }]
    else . end
')

if [ -z "$PRUNED" ]; then
  echo "⚠ The prune did not produce a valid document, leaving the ingress as it was"
  return 0
fi

echo "$PRUNED" | yq -P '.' > "$INGRESS_FILE.tmp" && mv "$INGRESS_FILE.tmp" "$INGRESS_FILE"

AFTER=$(yq '.spec.rules[0].http.paths | length' "$INGRESS_FILE")
REMOVED=$((BEFORE - AFTER))

if [ "$REMOVED" -gt 0 ]; then
  echo "✅ Pruned $REMOVED rule(s) with no active link (from $BEFORE to $AFTER paths)"
else
  echo "✅ No orphan rules to prune ($BEFORE paths)"
fi
