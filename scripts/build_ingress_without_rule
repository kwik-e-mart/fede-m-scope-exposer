#!/bin/bash

set -euo pipefail

INGRESS_NAME=$(kubectl get ingress -n "$K8S_NAMESPACE" -l "service_id=$SERVICE_ID" -o jsonpath="{.items[0].metadata.name}" 2>/dev/null || true)
if [ -z "$INGRESS_NAME" ]; then
  if [ -n "${SERVICE_NAME:-}" ]; then
    EXPECTED_INGRESS_NAME="k-8-s-${SERVICE_NAME}-${SERVICE_ID}-public"
    if kubectl get ingress -n "$K8S_NAMESPACE" "$EXPECTED_INGRESS_NAME" >/dev/null 2>&1; then
      INGRESS_NAME="$EXPECTED_INGRESS_NAME"
    fi
  fi
fi
if [ -z "$INGRESS_NAME" ]; then
  echo "Error: No ingress found in namespace [$K8S_NAMESPACE] for service_id=[$SERVICE_ID]. Expected an existing ingress to patch (e.g. created by workflow create.yaml)."
  exit 1
fi
INGRESS=$(kubectl get ingress -n "$K8S_NAMESPACE" "$INGRESS_NAME" -o json)

INGRESS_FILE="$OUTPUT_DIR/ingress-$SERVICE_ID-$SCOPE_ID-public.yaml"
ANNOTATION_KEY="alb.ingress.kubernetes.io/actions.bg-deployment-$SCOPE_ID"

echo "Removing paths $RULE_PATHS for scope $SCOPE_ID"

UPDATED_INGRESS=$(echo "$INGRESS" | jq \
  --argjson removed "$RULE_PATHS" \
  --arg annotation_key "$ANNOTATION_KEY" '
  .spec.rules[0].http.paths |= (
    map(select(.path as $path | $removed | index($path) == null))
    | if length == 0
      then [{path: "/", pathType: "Prefix", backend: {service: {name: "response-404", port: {name: "use-annotation"}}}}]
      else .
      end
  )
  | .metadata.annotations |= del(.[$annotation_key])
')

echo "$UPDATED_INGRESS" | yq eval -P '.' > "$INGRESS_FILE"

echo "Ingress configuration saved to: $INGRESS_FILE"
