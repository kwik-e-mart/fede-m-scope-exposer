#!/bin/bash

# Routes this scope's application logs to CloudWatch or Datadog by injecting the gate
# annotations through k8s_modifiers, the same channel build_tolerations and
# build_datadog_annotations already use.
#
# The logs controller gates each of its outputs on one annotation per provider:
#
#     <prefix>.cloudwatch: 'true'   |   <prefix>.datadog: 'true'
#
# The prefix defaults to `nullplatform.logs` and is whatever this cluster's controller
# is configured to read (CLOUDWATCH_LOGS_ANNOTATION / DATADOG_LOGS_ANNOTATION). It has
# to match exactly; one character off and the gate never matches and the logs are
# dropped with no error.
#
# Both keys are written on every run, the chosen provider "true" and the other
# "false". Writing only the chosen one is not enough: the rules are ADDITIVE, so a pod
# left carrying the scope template's `nullplatform.logs.cloudwatch: 'true'` plus an
# injected `nullplatform.logs.datadog: 'true'` is delivered to BOTH destinations and
# billed twice. Verified against Fluent Bit, along with the fix: "false" does not match
# the rule, so pinning the unchosen provider neutralises it.
#
# Overriding the template's own value works because k8s_modifiers can only ADD
# annotations, but the template merges `k8s_modifiers.deployment.annotations` AFTER its
# own logs block and duplicate YAML keys resolve last-wins. Verified by rendering the
# real template with a modifier that flips the key: the modifier's value survives.
#
# When the prefix is not the default, both families are written. The scope template may
# still be on a release that only knows `nullplatform.logs.*`, and a cluster may not
# have been pointed at the new prefix yet; covering both means neither side has to move
# first and no intermediate state loses logs.
#
# Deliberately separate from `setup_cloudwatch_logs`, which injects the
# aws-for-fluent-bit sidecar for one specific application and must keep working
# untouched. That script owns containers and volumes; this one owns annotations only.
# They never touch the same keys.

DEFAULT_PREFIX="nullplatform.logs"

# --- provider: where the logs go -------------------------------------------------
# The scope's own setting is checked first and outranks everything: an explicit
# cloudwatch/datadog choice is honored even when the organization has no logging
# integration configured. "default" (and absent/null/empty, which is what scopes
# created before the capability existed have) delegates to the org's integration.
PROVIDER=""
SCOPE_OVERRIDE=$(echo "$CONTEXT" | jq -r '.scope.capabilities.logs_provider_override // "default"')
case "$SCOPE_OVERRIDE" in
    cloudwatch|datadog)
        PROVIDER="$SCOPE_OVERRIDE"
        ;;
esac

# The organization's default is not an env var or a build-context key: it is whatever
# logging integration is configured for this scope's org and dimensions — the provider
# in the `logging` category (the category is declared in values.yaml so it is visible
# here). Its specification slug names the product, and that decides the destination.
#
# Only consulted when the scope delegates. No logging provider configured (and no
# explicit scope choice) means the routing feature is not set up for this
# org/dimension at all, so this script must touch nothing: no annotations, no
# modifiers.
if [ -z "$PROVIDER" ]; then
    NRN=$(echo "$CONTEXT" | jq -r .scope.nrn)
    DIMENSION_FILTER=$(echo "$CONTEXT" | jq -r '.scope.dimensions // {} | to_entries | map("\(.key):\(.value)") | join(",")')

    if [ -z "$DIMENSION_FILTER" ]; then
        PROVIDER_DATA=$(np provider list --categories logging --nrn "$NRN" --format json | jq -r ".results[0]")
    else
        PROVIDER_DATA=$(np provider list --categories logging --nrn "$NRN" --dimensions "$DIMENSION_FILTER" --format json | jq -r ".results[0]")
    fi

    if [ -z "$PROVIDER_DATA" ] || [ "$PROVIDER_DATA" = "null" ]; then
        echo "No logging provider configured for $NRN and no explicit scope override, leaving logs routing untouched"
        return
    fi

    SPECIFICATION_ID=$(echo "$PROVIDER_DATA" | jq -r '.specification_id // empty')
    if [ -n "$SPECIFICATION_ID" ]; then
        SPECIFICATION_SLUG=$(np provider specification read --id "$SPECIFICATION_ID" --format json | jq -r '.slug // empty')
        case "$SPECIFICATION_SLUG" in
            *datadog*)    PROVIDER="datadog" ;;
            *cloudwatch*) PROVIDER="cloudwatch" ;;
        esac
    fi

    if [ -z "$PROVIDER" ]; then
        echo "Could not map logging provider specification '$SPECIFICATION_SLUG' to a known logs provider, leaving logs routing untouched"
        return
    fi
fi

# --- prefix: which annotation family this cluster gates on ------------------------
# Account-level, not per-scope: it has to agree with the cluster's logs controller,
# and a per-scope value could disagree with it and route nowhere.
PREFIX="${LOGS_ANNOTATION_PREFIX:-$DEFAULT_PREFIX}"

# Unlike the provider, this is not derivable from the `logging` category integration:
# it is a property of the cluster's controller, not of the destination product.
# LOGS_ANNOTATION_PREFIX in values.yaml is the source of truth; this only picks up a
# value the base build_context already resolved, when there is one.
ACCOUNT_PREFIX=$(echo "$CONTEXT" | jq -r '.logs_annotation_prefix? // empty')
if [ -n "$ACCOUNT_PREFIX" ]; then
    PREFIX="$ACCOUNT_PREFIX"
fi

# The controller rejects anything outside this alphabet and refuses to start, so
# catching it here names the misconfiguration instead of shipping a broken manifest.
#
# `[[ =~ ]]` rather than piping to grep: grep matches line by line, so a value with an
# embedded newline passes on the strength of its first line alone and the newline ends
# up in an annotation key. This form anchors against the whole string.
if [[ ! "$PREFIX" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]]; then
    echo "ERROR: invalid logs annotation prefix '$PREFIX'" >&2
    exit 1
fi

echo "Routing application logs to: $PROVIDER (annotation prefix: $PREFIX)"

# --- naming: where CloudWatch logs land ------------------------------------------
# The scope template used to stamp these four as literals, so every account got the
# same log group and the same 7-day retention with no way to change either. They live
# here now, alongside the gates, because both are the same concern: this script owns
# what the logs controller reads.
#
# Each value is rendered against the deployment context, so a value can derive from it
# the way the defaults do — that is what makes `{{ .namespace.slug }}.{{ .application.slug }}`
# work as a configurable value rather than a fixed string.
#
# `${type}`, `${instance}` and `${container}` are NOT rendered here on purpose: the
# controller's Lua resolves those per record, at runtime. gomplate leaves `$` alone, so
# one value can carry both layers, which is what the stream pattern has always done.
# An explicitly empty value means "do not stamp this annotation", which is why each one
# is tested with ${VAR+set} rather than :- — an unset variable takes the default, an
# empty one suppresses the key.
LOGS_NAMING_ANNOTATIONS='{}'
if [ "$PROVIDER" = "cloudwatch" ]; then
    add_naming_annotation() {
        local key="$1" var_name="$2" default_value="$3" value rendered

        if [ -n "${!var_name+set}" ]; then
            value="${!var_name}"
        else
            value="$default_value"
        fi

        [ -z "$value" ] && return 0

        # Rendered here and not inside the jq call below: `exit` from a command
        # substitution only leaves the subshell, so a failed render would print its
        # error and then stamp an empty value — a wrong destination, silently. A typo
        # in an operator's pattern has to break the deployment instead.
        if ! rendered=$(printf '%s' "$CONTEXT" | gomplate -c .=stdin:///context.json -i "$value" 2>&1); then
            echo "ERROR: could not render logs annotation '$key' from '$value': $rendered" >&2
            exit 1
        fi

        LOGS_NAMING_ANNOTATIONS=$(echo "$LOGS_NAMING_ANNOTATIONS" | jq -c \
          --arg k "nullplatform.logs.cloudwatch.$key" \
          --arg v "$rendered" '. + {($k): $v}')
    }

    add_naming_annotation log_group_name LOGS_CLOUDWATCH_LOG_GROUP_NAME \
        '{{ .namespace.slug }}.{{ .application.slug }}'
    add_naming_annotation log_stream_log_retention_days LOGS_CLOUDWATCH_LOG_RETENTION_DAYS \
        '7'
    add_naming_annotation log_stream_name_pattern LOGS_CLOUDWATCH_LOG_STREAM_NAME_PATTERN \
        'type=${type};application={{ .application.id }};scope={{ .scope.id }};deploy={{ .deployment.id }};instance=${instance};container=${container}'
    add_naming_annotation region LOGS_CLOUDWATCH_REGION \
        '{{ .region }}'
fi

# --- inject ----------------------------------------------------------------------
# Every gate this pod could be read on, stated explicitly either way, plus the naming
# for the destination it was routed to.
LOGS_ANNOTATIONS=$(jq -nc \
  --arg prefix "$PREFIX" \
  --arg default_prefix "$DEFAULT_PREFIX" \
  --arg provider "$PROVIDER" \
  --argjson naming "$LOGS_NAMING_ANNOTATIONS" '
    def gates($p): {
      "\($p).cloudwatch": (if $provider == "cloudwatch" then "true" else "false" end),
      "\($p).datadog":    (if $provider == "datadog"    then "true" else "false" end)
    };
    gates($prefix) + (if $prefix == $default_prefix then {} else gates($default_prefix) end) + $naming
')

MODIFIERS=$(echo "$CONTEXT" | jq .k8s_modifiers)
MODIFIERS=$(echo "$MODIFIERS" | jq --argjson logs_annotations "$LOGS_ANNOTATIONS" '
  .deployment.annotations = ((.deployment.annotations // {}) + $logs_annotations)
')
CONTEXT=$(echo "$CONTEXT" | jq --argjson modifiers "$MODIFIERS" '.k8s_modifiers = $modifiers')

echo "Logs annotations set on k8s_modifiers.deployment.annotations:"
echo "$LOGS_ANNOTATIONS" | jq -r 'to_entries[] | "  \(.key): \(.value)"'
