#!/bin/bash

# setup_logs_provider resolves the destination and leaves it in the context.
if [ "$(echo "$CONTEXT" | jq -r '.logs_provider_resolved // empty')" = "cloudwatch" ]; then
    echo "Logs provider is cloudwatch, skipping datadog annotations"
    return 0
fi

ENVIRONMENT=$(echo "$CONTEXT" | jq -r .scope.dimensions.environment)
SERVICE=$(basename "$(echo "$CONTEXT" | jq -r '.application.repository_url')-kubernetes" | cut -c1-63)
SERVICE=${SERVICE%-}
VERSION=$(echo "$CONTEXT" | jq -r .release.semver)
DRP_CLUSTER_NAME=spin-cluster-dr
# sync-squad-metadata writes the catalog-info owner to tags.squad_name; read owner first for the rename.
# "None" matches the owner tag on AWS resources (genesys-platform), so Cloudability groups both alike.
OWNER=$(echo "$CONTEXT" | jq -r '.application.tags.owner // .application.tags.squad_name // "None"')
if [[ ! "$OWNER" =~ ^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$ ]]; then
  echo "Owner '$OWNER' is not a valid label value, using None"
  OWNER=None
fi

ARCHITECTURE=$(echo "$CONTEXT" | jq -r .application.metadata.scaffolding.architecture_type)

#admission.datadoghq.com/java-lib.version: "v1.50.0"
#admission.datadoghq.com/python-lib.version: "v3.9.3"
#admission.datadoghq.com/js-lib.version:  "v5.56.0"
#admission.datadoghq.com/ruby-lib.version: "v2.17.0"
#admission.datadoghq.com/dotnet-lib.version: "v3.19.0"

if [[ "$ENVIRONMENT" == 'prd' ]]; then ENVIRONMENT=prod; fi

DD_ENV="$ENVIRONMENT"

if [[ "$CLUSTER_NAME" == "$DRP_CLUSTER_NAME" ]]; then
  DD_ENV=dr
fi

case "$ARCHITECTURE" in
  "react-"* | "js-"*)
    TECHNOLOGY=js
    DATADOG_LIB_VERSION=v5.56.0
    ;;
  "spring-boot-"* | "java-"*)
      TECHNOLOGY=java
      DATADOG_LIB_VERSION=v1.50.0
      ;;
  "python-"*)
      TECHNOLOGY=python
      DATADOG_LIB_VERSION=v3.9.3
      ;;
  "ruby-"*)
      TECHNOLOGY=ruby
      DATADOG_LIB_VERSION=v2.17.0
      ;;
  "dotnet-"*)
      TECHNOLOGY=dotnet
      DATADOG_LIB_VERSION=v3.19.0
      ;;
  *)
    TECHNOLOGY=
    DATADOG_LIB_VERSION=
    echo "There is no known datadog lib for architecture: $ARCHITECTURE, the technology-specific annotation will be skipped."
    ;;
esac

DATADOG_LABELS=$(jq -n --arg env "$DD_ENV" --arg service "$SERVICE" --arg version "$VERSION" --arg owner "$OWNER" '{
  "owner": $owner,
  "tags.datadoghq.com/env": $env,
  "tags.datadoghq.com/service": $service,
  "tags.datadoghq.com/version": $version,
  "admission.datadoghq.com/enabled": "true",
  "admission.datadoghq.com/config.mode": "socket"
}')

DATADOG_ANNOTATIONS=$(jq -n --arg owner "$OWNER" '{
  "ad.datadoghq.com/tags": ({team: $owner, squad: $owner} | tojson)
}')

if [[ -n "$TECHNOLOGY" ]]; then
  DATADOG_ANNOTATIONS=$(echo "$DATADOG_ANNOTATIONS" | jq --arg technology "$TECHNOLOGY" --arg lib_version "$DATADOG_LIB_VERSION" '
    . + { ("admission.datadoghq.com/" + $technology + "-lib.version"): $lib_version }
  ')
  if [[ "$SERVICE" == "tr-spin-transaction-svc-backend-java-gradle-kubernetes" ]]; then
    DATADOG_ANNOTATIONS=$(echo "$DATADOG_ANNOTATIONS" | jq --arg technology "$TECHNOLOGY" --arg lib_version "$DATADOG_LIB_VERSION" '
      . + { "ad.datadoghq.com/tr-spin-transaction-svc-backend-java-gradle-kubernetes.logs": "[{\"source\": \"tr-spin-transaction-svc-backend-java-gradle-kubernetes\", \"service\": \"tr-spin-transaction-svc-backend-java-gradle-kubernetes\", \"log_processing_rules\": [{\"type\": \"include_at_match\", \"name\": \"checks\", \"pattern\": \"TIMED OUT-SYSTEM|service temporary unavailable\"}]}]"}
    ')
  fi
fi

MODIFIERS=$(echo "$CONTEXT" | jq .k8s_modifiers)

MODIFIERS=$(echo "$MODIFIERS" | jq --argjson datadog_annotations "$DATADOG_ANNOTATIONS" --argjson datadog_labels "$DATADOG_LABELS" '
  .deployment.annotations = ((.deployment.annotations // {}) + $datadog_annotations) |
  .deployment.labels = ((.deployment.labels // {}) + $datadog_labels)
')

CONTEXT=$(echo "$CONTEXT" | jq  --argjson modifiers "$MODIFIERS"  '.k8s_modifiers = $modifiers')

echo "Adding datadog annotations:"
echo "$DATADOG_ANNOTATIONS" | jq .

echo "Adding datadog labels:"
echo "$DATADOG_LABELS" | jq .
