#!/bin/bash

EXPOSER_POLL_SECONDS=5

link_state() {
  if [[ "$1" == gone ]]; then
    echo "ya no existe"
  else
    echo "en estado $1"
  fi
}

exposer_retry_hint() {
  case "$1" in
    deleting) echo "Cuando el link termine de borrarse, reintentá el paso o hacé rollback." ;;
    archiving) echo "Cuando el link termine de archivarse, reintentá el paso o hacé rollback." ;;
    gone|"") echo "Reintentá el paso o hacé rollback." ;;
    *) echo "Cuando el link vuelva a active, reintentá el paso o hacé rollback." ;;
  esac
}

exposer_sync_failed() {
  echo "❌ No se pudo sincronizar el exposer ($1). Las dos versiones siguen activas. $(exposer_retry_hint "$2")"
}

list_exposer_links() {
  local nrn="$1" limit=200 response
  if ! response=$(np link list --nrn "$nrn" --limit "$limit" --format json); then
    echo "No se pudieron listar los links de $nrn: $response" >&2
    return 1
  fi
  if ! jq -e '.results | type == "array"' <<<"$response" >/dev/null 2>&1; then
    echo "Respuesta inválida al listar los links de $nrn: $response" >&2
    return 1
  fi
  if (( $(jq '.results | length' <<<"$response") >= limit )); then
    echo "La lista de links de $nrn trajo $limit links, el máximo de una lectura; no se puede confirmar que esté completa" >&2
    return 1
  fi
  jq -c --arg spec "$LINK_SPECIFICATION_ID" '.results | map(select(.specification_id == $spec))' <<<"$response"
}

read_link_status() {
  local link_id="$1" response
  if ! response=$(np link read --id "$link_id" --format json); then
    if [[ "$response" == *"status 404"* ]]; then
      echo "gone"
      return 0
    fi
    echo "No se pudo leer el link $link_id: $response" >&2
    return 1
  fi
  jq -r '.status // empty' <<<"$response"
}

wait_link_active() {
  local link_id="$1" waited=0 status
  while true; do
    if ! status=$(read_link_status "$link_id"); then
      FAILURE_REASON="no se pudo leer el link"
      return 1
    fi
    LINK_STATE="$status"
    echo "Link $link_id $(link_state "$status") a los ${waited}s"
    case "$status" in
      active) return 0 ;;
      pending|pending_create|creating|updating) ;;
      *)
        FAILURE_REASON="se esperaba que pasara a active"
        return 1
        ;;
    esac
    if (( waited >= EXPOSER_LINK_WAIT_SECONDS )); then
      FAILURE_REASON="tope de ${EXPOSER_LINK_WAIT_SECONDS}s (EXPOSER_LINK_WAIT_SECONDS) vencido"
      return 1
    fi
    sleep "$EXPOSER_POLL_SECONDS"
    waited=$((waited + EXPOSER_POLL_SECONDS))
  done
}

wait_link_gone() {
  local link_id="$1" waited=0 status
  while true; do
    if ! status=$(read_link_status "$link_id"); then
      FAILURE_REASON="no se pudo leer el link"
      return 1
    fi
    LINK_STATE="$status"
    echo "Link $link_id $(link_state "$status") a los ${waited}s"
    case "$status" in
      gone|deleted|archived)
        echo "Link $link_id eliminado, no hay nada que sincronizar"
        return 0
        ;;
      deleting|archiving) ;;
      *)
        FAILURE_REASON="se esperaba que se eliminara"
        return 1
        ;;
    esac
    if (( waited >= EXPOSER_LINK_WAIT_SECONDS )); then
      FAILURE_REASON="tope de ${EXPOSER_LINK_WAIT_SECONDS}s (EXPOSER_LINK_WAIT_SECONDS) vencido"
      return 1
    fi
    sleep "$EXPOSER_POLL_SECONDS"
    waited=$((waited + EXPOSER_POLL_SECONDS))
  done
}

resolve_refresh_action_id() {
  local actions
  if [[ -n "$REFRESH_ACTION_ID" ]]; then
    return 0
  fi
  if ! actions=$(np link specification action specification list --linkSpecificationId "$LINK_SPECIFICATION_ID" --format json); then
    echo "No se pudieron leer las actions de la link specification $LINK_SPECIFICATION_ID: $actions"
    FAILURE_REASON="no se pudieron leer las actions de la link specification"
    return 1
  fi
  REFRESH_ACTION_ID=$(jq -r '[.results[]? | select(.slug == "refresh")][0].id // empty' <<<"$actions")
  if [[ -z "$REFRESH_ACTION_ID" ]]; then
    FAILURE_REASON="la link specification $LINK_SPECIFICATION_ID no tiene la action refresh"
    return 1
  fi
}

wait_action() {
  local link_id="$1" action_id="$2" waited=0 response status
  while true; do
    if ! response=$(np link action read --linkId "$link_id" --id "$action_id" --format json); then
      echo "No se pudo leer el refresh $action_id del link $link_id: $response"
      FAILURE_REASON="no se pudo leer el refresh $action_id"
      return 1
    fi
    status=$(jq -r '.status // empty' <<<"$response")
    echo "Refresh $action_id del link $link_id en estado $status a los ${waited}s"
    case "$status" in
      success)
        echo "✅ Ingress público sincronizado para el link $link_id"
        return 0
        ;;
      pending|pending_create|in_progress) ;;
      failed|cancelled)
        FAILURE_REASON="refresh $action_id $status"
        return 1
        ;;
      *)
        FAILURE_REASON="refresh $action_id en estado inesperado '$status'"
        return 1
        ;;
    esac
    if (( waited >= EXPOSER_ACTION_WAIT_SECONDS )); then
      FAILURE_REASON="refresh $action_id sigue $status tras el tope de ${EXPOSER_ACTION_WAIT_SECONDS}s (EXPOSER_ACTION_WAIT_SECONDS)"
      return 1
    fi
    sleep "$EXPOSER_POLL_SECONDS"
    waited=$((waited + EXPOSER_POLL_SECONDS))
  done
}

run_refresh() {
  local link_id="$1" attempt response action_id body
  resolve_refresh_action_id || return 1
  body="{\"name\": \"refresh\", \"parameters\": {}, \"specification_id\": \"$REFRESH_ACTION_ID\"}"
  for attempt in 1 2 3; do
    if response=$(np link action create --linkId "$link_id" --body "$body" --format json); then
      action_id=$(jq -r '.id // empty' <<<"$response")
      if [[ -z "$action_id" ]]; then
        echo "Respuesta al crear el refresh del link $link_id: $response"
        FAILURE_REASON="el refresh se creó sin id"
        return 1
      fi
      echo "Refresh $action_id creado para el link $link_id"
      wait_action "$link_id" "$action_id"
      return
    fi
    if [[ "$response" != *"Only active links"* ]]; then
      echo "No se pudo crear el refresh del link $link_id: $response"
      FAILURE_REASON="no se pudo crear el refresh"
      return 1
    fi
    echo "El link $link_id dejó de estar active antes del refresh (intento $attempt); se espera de nuevo"
    wait_link_active "$link_id" || return 1
  done
  FAILURE_REASON="el link rechazó el refresh $attempt veces"
  return 1
}

sync_exposer_link() {
  local link_id="$1" status="$2"
  echo "Link $link_id del exposer en estado $status"
  case "$status" in
    active) run_refresh "$link_id" ;;
    pending|pending_create|creating|updating) wait_link_active "$link_id" && run_refresh "$link_id" ;;
    deleting|archiving) wait_link_gone "$link_id" ;;
    deleted|archived) echo "Link $link_id ignorado" ;;
    *) return 1 ;;
  esac
}

EXPOSER_LINK_WAIT_SECONDS=${EXPOSER_LINK_WAIT_SECONDS-360}
EXPOSER_ACTION_WAIT_SECONDS=${EXPOSER_ACTION_WAIT_SECONDS-420}
for wait_var in EXPOSER_LINK_WAIT_SECONDS EXPOSER_ACTION_WAIT_SECONDS; do
  if [[ ! "${!wait_var}" =~ ^[0-9]+$ ]]; then
    echo "❌ $wait_var debe ser un número entero de segundos, se recibió '${!wait_var}'"
    exit 1
  fi
done

SCOPE_NRN=$(jq -r .scope.nrn <<<"$CONTEXT")
REFRESH_ACTION_ID=""

echo "LINK SPECIFICATION ID: $LINK_SPECIFICATION_ID, SCOPE_NRN: $SCOPE_NRN"

if ! EXPOSER_LINKS=$(list_exposer_links "$SCOPE_NRN"); then
  exposer_sync_failed "no se pudieron leer los links del scope"
  exit 1
fi

if [[ "$(jq 'length' <<<"$EXPOSER_LINKS")" -eq 0 ]]; then
  echo "El scope no es público, no hay ingress público que sincronizar"
  return 0
fi

echo "El scope es público, sincronizando el ingress público"

for link_id in $(jq -r '.[].id' <<<"$EXPOSER_LINKS"); do
  link_status=$(jq -r --arg id "$link_id" '.[] | select((.id | tostring) == $id) | .status' <<<"$EXPOSER_LINKS")
  LINK_STATE="$link_status"
  FAILURE_REASON=""
  if ! sync_exposer_link "$link_id" "$link_status"; then
    exposer_sync_failed "link $link_id $(link_state "$LINK_STATE")${FAILURE_REASON:+; $FAILURE_REASON}" "$LINK_STATE"
    exit 1
  fi
done
